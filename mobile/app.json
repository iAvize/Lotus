{
  "expo": {
    "name": "Lotus Beta",
    "slug": "lotus-beta",
    "version": "0.1.0-beta.7",
    "scheme": "lotusbeta",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#080512",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "cover",
      "backgroundColor": "#080512"
    },
    "ios": {
      "bundleIdentifier": "com.avize.lotus.beta",
      "appleTeamId": "79TQF5SX8Z",
      "buildNumber": "5",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": false
        },
        "NSCameraUsageDescription": "Lotus does not use the camera.",
        "NSLocationWhenInUseUsageDescription": "Lotus does not use your location.",
        "NSUserTrackingUsageDescription": "Lotus does not track you."
      }
    },
    "android": {
      "package": "com.avize.lotus.beta",
      "versionCode": 2,
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#080512"
      }
    },
    "androidStatusBar": {
      "barStyle": "light-content",
      "backgroundColor": "#080512",
      "translucent": true
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://lotus-updates.web.app/manifest.json",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "plugins": [
      "expo-secure-store",
      "expo-status-bar"
    ]
  }
}